#!/usr/bin/env bash
# Records an agent's state for Briefpane: one JSON file per tmux pane.
# Claude: briefpane-hook claude <state>, event JSON on stdin.
# Codex:  briefpane-hook codex <state> '<event json>' (its notify passes JSON as an argument).
set -euo pipefail
[ -n "${TMUX_PANE:-}" ] || exit 0
agent=$1 state=$2
if [ $# -ge 3 ]; then event=$3; elif [ ! -t 0 ]; then event=$(cat); else event='{}'; fi
field() { jq -r "$1 // empty" <<<"$event" 2>/dev/null || true; }
message=$(field .message)
transcript=$(field .transcript_path)        # Claude: the session's JSONL
last=$(field '.["last-assistant-message"]') # Codex: its final answer
dir="${XDG_STATE_HOME:-$HOME/.local/state}/briefpane/panes"
mkdir -p "$dir"
file="$dir/${TMUX_PANE#%}.json"
jq -n --arg agent "$agent" --arg state "$state" --arg message "$message" \
  --arg transcript "$transcript" --arg last "$last" --argjson at "$(date +%s)" \
  '{agent: $agent, state: $state, message: $message, transcript: $transcript, last: $last, at: $at}' >"$file.tmp"
mv "$file.tmp" "$file"
